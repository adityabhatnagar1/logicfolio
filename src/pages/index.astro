---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { site } from '../lib/site';
import { url } from '../lib/paths';
import { getCategories, getRecent, categoryHref, componentHref, formatDate, pad } from '../lib/archive';

const categories = getCategories();
const recent = getRecent(4);
const total = categories.reduce((n, c) => n + c.components.length, 0);
---

<ArchiveLayout home description={site.description}>
  <div class="wrap">
  <form class="search-form search-form--home" role="search" action={url('/search/')} method="get">
          <label class="visually-hidden" for="hero-search">Search components and notes</label>
          <span class="search-leading" aria-hidden="true">
            <svg
              width="18"
              height="18"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="8.5" cy="8.5" r="4.75" />
              <line x1="12.2" y1="12.2" x2="16.5" y2="16.5" />
            </svg>
          </span>
          <input
            id="hero-search"
            type="search"
            name="q"
            placeholder="Search components, logic circuits, notes..."
            autocomplete="off"
            aria-keyshortcuts="/"
            data-search-input
          />
          <kbd class="search-hotkey-hint" aria-hidden="true">/</kbd>
          <button type="submit" aria-label="Search archive">
            <svg class="search-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10 H16 M11 5 L16 10 L11 15" />
            </svg>
          </button>
        </form>
    <section class="hero" aria-labelledby="name">
      <div class="hero-copy">
        <p class="meta hero-count">{site.eyebrow}</p>
        <h1 id="name" class="hero-title-signature" aria-label={site.name}>
  {
    site.name.split('').map((character, index) => (
      <span
        class="hero-glyph"
        aria-hidden="true"
        style={`--glyph-delay: ${100 + index * 55}ms`}
      >
        {character === ' ' ? '\u00A0' : character}
      </span>
    ))
  }
</h1>
        <p class="lead">
          <strong class="lead-head">{site.tagline}</strong>
          <span class="lead-sub">{site.intro}</span>
        </p>
        
      </div>

      <figure class="lighthouse" data-hero data-state="loading">
        <div class="lighthouse-plate" data-hero-plate>
          <canvas
            class="lighthouse-canvas"
            data-hero-canvas
            width="540"
            height="960"
            role="img"
            aria-label="A one-bit pixel-art lighthouse on a rocky shore. Its beam sweeps slowly across the sea."></canvas>
        </div>
      </figure>
    </section>

    <div class="home-discovery-grid">
      <section class="band band--domains" aria-labelledby="categories-heading">
        <div class="band-header">
          <h2 class="label meta" id="categories-heading">Domains</h2>
          <span class="band-subtitle meta">{categories.length} categories available</span>
        </div>
        <div class="band-body">
          {
            categories.length === 0 ? (
              <p class="meta">No domains yet. Add a component to get started.</p>
            ) : (
              <div class="domain-grid" role="list">
                {categories.map((cat) => (
                  <a class="domain-card" href={categoryHref(cat)} role="listitem">
                    <div class="domain-card-main">
                      <span class="domain-card-title">{cat.name}</span>
                    </div>
                    <span class="domain-card-count meta">
                      {cat.components.length} {cat.components.length === 1 ? 'item' : 'items'}
                    </span>
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </section>

      {
        recent.length > 0 && (
          <section class="band band--recent" aria-labelledby="recent-heading">
            <div class="band-header">
              <h2 class="label meta" id="recent-heading">Recently added</h2>
              <span class="band-subtitle meta">Latest design additions</span>
            </div>
            <div class="band-body">
              <ol class="recent-list" role="list">
                {recent.map((c) => (
                  <li class="recent-item">
                    <a class="recent-link" href={componentHref(c)}>
                      <div class="recent-primary">
                        <span class="recent-title">{c.name}</span>
                        <span class="recent-tag meta">{c.categoryName}</span>
                      </div>
                      <time class="recent-date meta" datetime={formatDate(c.updated)}>{formatDate(c.updated)}</time>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }
    </div>
  </div>

  <script>
    import { mountLighthouseHero } from '../lib/lighthouse-hero';
    const figure = document.querySelector<HTMLElement>('[data-hero]');
    const plate = document.querySelector<HTMLElement>('[data-hero-plate]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (figure && plate && canvas) mountLighthouseHero(canvas, plate, figure);
  </script>
</ArchiveLayout>
