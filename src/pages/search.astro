---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import SearchHero from '../components/SearchHero.astro';
import SearchField from '../components/SearchField.astro';
import FilterBar from '../components/FilterBar.astro';
import StatusLine from '../components/StatusLine.astro';
import ResultList from '../components/ResultList.astro';
import EmptyState from '../components/EmptyState.astro';
import DomainGrid from '../components/DomainGrid.astro';
import RecentList from '../components/RecentList.astro';
import { baseUrl } from '../lib/paths';
import { getCategories, getRecent } from '../lib/archive';

const categories = getCategories().map((c) => ({ slug: c.slug, name: c.name, count: c.components.length }));
const recent = getRecent(4);
---

<ArchiveLayout title="Search" headerSearch={false} page="search">
  <div class="wrap search-page" data-search-page data-base={baseUrl} data-state="idle">
    <SearchHero />
    <SearchField />
    <FilterBar categories={categories} />
    <StatusLine />

    <div class="search-state" data-state-block="idle">
      <div class="home-discovery-grid">
        <DomainGrid categories={categories} />
        <RecentList items={recent} />
      </div>
    </div>

    <div class="search-state" data-state-block="searching">
      <ol class="index result-placeholder" role="list" aria-hidden="true">
        <li><span class="index-num meta">01</span><div><span class="result-bar result-bar--title"></span><span class="result-bar"></span></div></li>
        <li><span class="index-num meta">02</span><div><span class="result-bar result-bar--title"></span><span class="result-bar"></span></div></li>
        <li><span class="index-num meta">03</span><div><span class="result-bar result-bar--title"></span><span class="result-bar"></span></div></li>
      </ol>
    </div>

    <div class="search-state" data-state-block="results">
      <ResultList />
    </div>

    <div class="search-state" data-state-block="empty">
      <EmptyState categories={categories} />
    </div>

    <div class="search-state" data-state-block="error">
      <div class="note">
        <p>Search could not load its index.</p>
        <p class="meta">Check your connection and try again.</p>
        <p><button type="button" class="filter-chip" data-retry>Try again</button></p>
      </div>
    </div>

    <div class="search-state" data-state-block="no-index">
      <div class="note">
        <p>Search needs a built index.</p>
        <p class="meta">Run <code>npm run build &amp;&amp; npm run preview</code>, then open this page again.</p>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/search';
  </script>
</ArchiveLayout>
