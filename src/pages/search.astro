---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { url, baseUrl } from '../lib/paths';
---

<ArchiveLayout title="Search" headerSearch={false}>
  <div class="wrap" data-search-page data-base={baseUrl}>
    <header class="page-head">
      <h1>Search</h1>
      {
        import.meta.env.DEV && (
          <p class="note meta">
            Search needs a built index: run <code>npm run build &amp;&amp; npm run preview</code>.
          </p>
        )
      }
    </header>
    <form class="search-form search-form--hero" role="search" action={url('/search/')} method="get">
      <label class="visually-hidden" for="search-input">Search components and notes</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="Search components and notes..."
          autocomplete="off"
          aria-keyshortcuts="/"
          data-search-input
        />
      <button type="submit" aria-label="Submit search">
  <svg
    class="search-arrow"
    width="18"
    height="18"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 10 H16 M11 5 L16 10 L11 15" />
  </svg>
</button>
    </form>
    <p class="meta search-status" role="status" aria-live="polite" data-search-status></p>
    <ol class="index" role="list" data-search-results></ol>
  </div>
  <script>
    import '../scripts/search';
  </script>
</ArchiveLayout>
