---
import { url } from '../lib/paths';
---

<form class="search-form search-form--page search-form--large" role="search" action={url('/search/')} method="get" data-motion="search-field" data-search-form>
  <label class="visually-hidden" for="search-input">Search components and notes</label>
  <span class="search-leading" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="8.5" cy="8.5" r="4.75"></circle>
      <line x1="12.2" y1="12.2" x2="16.5" y2="16.5"></line>
    </svg>
  </span>
  <input
    id="search-input"
    type="search"
    name="q"
    placeholder="Search components, logic gates, notes..."
    autocomplete="off"
    aria-keyshortcuts="/"
    data-search-input
  />
  <kbd class="search-hotkey-hint" aria-hidden="true">/</kbd>
  <button type="submit" aria-label="Submit search">
    <svg class="search-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 10 H16 M11 5 L16 10 L11 15"></path>
    </svg>
  </button>
</form>
